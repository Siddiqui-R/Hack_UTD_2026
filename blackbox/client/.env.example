# Public client configuration only. Never put NVIDIA or anchor secrets in VITE_* variables.
VITE_STDB_URI=ws://localhost:3000
VITE_STDB_DB=blackbox
# Default /api/pdf fetches a fresh authorized module snapshot and forwards it to Rabeet.
# Configure PDF_RENDERER_URL and optional PDF_RENDERER_TOKEN as SERVER-side Vercel variables.
# Override only for a direct snapshot-to-PDF endpoint. No session token is sent to custom URLs.
VITE_PDF_URL=
