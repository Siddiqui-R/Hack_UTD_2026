# BLACKBOX agent settings. Copy to `.env` in the repo root. `.env` is gitignored: NEVER commit it, the repo is public.
# Only the machine that runs the agent needs this file; nobody else needs the key.

# NVIDIA key from build.nvidia.com (starts with nvapi-). Only live runs use it, for example the golden transcript:
#   cd agent && npm run agent:cloud:live     (FAST model, on the incident the Maincloud worker is enrolled on)
# Each live run spends about 6-8 of the team's 40 hosted calls (tracked in agent-logs/live-call-count.json).
NVIDIA_API_KEY=

# Hosted NVIDIA API. A self-hosted NIM/vLLM endpoint (e.g. on Brev) also works and skips the call budget.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# FAST is the default INVESTIGATE model; DEEP is the "Deep Analysis" button. Same code path, only the model differs.
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b

# Default for `npm run agent`: mock (scripted, no credits) | replay (plays a recorded live run) | live (spends credits).
# The queue worker (`npm run worker:cloud`) only ever runs mock or replay, whatever this says.
AGENT_MODE=mock

# Database target: leave these unset. Local (127.0.0.1:3000, db blackbox) is the default; any agent command with
# --cloud uses Maincloud (blackbox-utd2026-abbas9x) and its own token file, agent/.agent-token.maincloud.
# STDB_URL=http://127.0.0.1:3000
# STDB_DB=blackbox
